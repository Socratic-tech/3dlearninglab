# ── App ───────────────────────────────────────────────
APP_URL=http://localhost:3000
# 32 random bytes, base64. Encrypts OAuth tokens. Generate: openssl rand -base64 32
APP_SECRET=

# ── Database ──────────────────────────────────────────
# Leave empty to use the embedded PGlite database in .data/pglite (zero setup, auto-seeded demo).
# Supabase: use the *transaction pooler* connection string (port 6543).
DATABASE_URL=
DATABASE_POOL_MAX=5
PGLITE_DIR=.data/pglite

# ── Google (Sign in + Classroom) ──────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails that become platform admins on first Google sign-in
PLATFORM_ADMIN_EMAILS=
# true = simulated Classroom (no Google calls). Automatically used for demo accounts.
CLASSROOM_FAKE=false

# ── Demo ──────────────────────────────────────────────
# Demo accounts (/demo) are on in development. In production set DEMO_MODE=true to expose them.
DEMO_MODE=false

# ── File storage ──────────────────────────────────────
# local (writes to LOCAL_STORAGE_DIR) | supabase (private bucket)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=academy-private
MAX_UPLOAD_MB=25
